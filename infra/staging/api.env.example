# Materialize as STAGING_SECRET_ROOT/api.env from the approved secret store.
# This file contains names only. Generate independent keys in that store.
JWT_SECRET=
MFA_ENCRYPTION_KEY=
PUSH_TOKEN_ACTIVE_KEY_ID=
PUSH_TOKEN_KEYS_JSON=
SPARROW_SMS_TOKEN=
SPARROW_SMS_IDENTITY=
# Configure genuine push delivery only when its staging provider is ready.
# PUSH_PROVIDER=fcm
# FCM_SERVICE_ACCOUNT_JSON=
# The email OTP provider variables must match the reviewed email implementation.
# Never enable ALLOW_SIMULATED_NOTIFICATIONS or a production OTP disclosure route.
# Approved free-tier transactional sender. Production runtime always uses Brevo.
EMAIL_PROVIDER=brevo
EMAIL_SENDER=
EMAIL_API_KEY=
# Independent high-entropy HMAC key, at least 32 characters. No JWT/MFA key reuse.
EMAIL_OTP_HASH_KEY=
