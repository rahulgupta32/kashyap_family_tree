{
  "name": "kashyap-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Kashyap Adhikari Family Tree Platform — Monorepo",
  "author": "Jyphra Technology Pvt. Ltd.",
  "license": "SEE LICENSE IN LICENSE_DECISION_REQUIRED.md",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:apps": "pnpm --filter \"./services/*\" --filter \"./apps/*\" run build",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "typecheck:packages": "pnpm --filter \"./packages/*\" run typecheck",
    "typecheck:apps": "pnpm --filter \"./services/*\" --filter \"./apps/*\" run typecheck",
    "typecheck": "pnpm run build:packages && pnpm run typecheck:packages && pnpm run typecheck:apps",
    "test": "pnpm --filter @kashyap/api test",
    "test:integration": "pnpm --filter @kashyap/api run test:integration",
    "test:e2e": "playwright test",
    "seed": "pnpm --filter @kashyap/api run seed",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "clean": "pnpm -r run clean",
    "audit:production": "pnpm audit --prod --audit-level=low"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.0",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "js-yaml@^5": "5.4.1",
      "postcss": "8.5.29"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
