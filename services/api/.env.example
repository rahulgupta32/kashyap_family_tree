# Kashyap Adhikari Family Tree Platform - API Configuration
# Copy this file to .env.local for local development

NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
# Default connects to PostgreSQL cluster running in WSL Ubuntu via bridge or direct
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=kashyap_user
DB_PASSWORD=kashyap_secure_dev_password
DB_NAME=kashyap_db
USE_REAL_POSTGRES=true

# Security & JWT
JWT_SECRET=kashyap_super_secret_jwt_key_2026_dev_only

# Redis Cache (Optional in dev)
REDIS_HOST=localhost
REDIS_PORT=6379
