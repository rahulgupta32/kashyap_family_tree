# Kashyap Adhikari Family Tree Platform - API Configuration
# Copy this file to .env.local for local development

NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
# Default connects to PostgreSQL cluster running in WSL Ubuntu via bridge or direct
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=kashyap_user
DB_PASSWORD=
DB_NAME=kashyap_db
USE_REAL_POSTGRES=true

# Security & JWT
JWT_SECRET=

# Redis Cache (Optional in dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional read-only legacy source mount when private S3 is enabled.
# No legacy source file is removed by migration. Restrict the mount to the uploads root.
# MEDIA_LEGACY_STORAGE_PATH=/mnt/legacy-uploads
# Exact original DB location prefix; omit when it equals the mounted path.
# MEDIA_LEGACY_LOCATION_PREFIX=D:\Jyphra\kashyap_family_tree\storage\uploads

# Required only for private contact import staging. Independent canonical base64 32-byte key.
# Provision through managed secrets; never reuse MFA_ENCRYPTION_KEY or commit a real value.
IMPORT_CONTACTS_ENCRYPTION_KEY=

# Optional keyring for rotation: secret JSON object of up to 10 key IDs to base64 keys.
# Retain old keys while any staged ciphertext or restorable backup references them.
IMPORT_CONTACTS_ENCRYPTION_KEYS_JSON=
IMPORT_CONTACTS_ENCRYPTION_ACTIVE_KEY_ID=
