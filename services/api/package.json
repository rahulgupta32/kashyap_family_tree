{
  "name": "@kashyap/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && node -e \"const fs=require('fs'); if (!fs.existsSync('dist/src')) fs.mkdirSync('dist/src', {recursive: true}); fs.writeFileSync('dist/src/main.js', 'require(\\\"../main\\\");');\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test:unit": "jest --testPathIgnorePatterns=\"integration\"",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test": "jest --testPathIgnorePatterns=\"integration\"",
    "seed": "ts-node src/database/seed.command.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@kashyap/contracts": "workspace:*",
    "@kashyap/localization": "workspace:*",
    "@kashyap/test-fixtures": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "8.18.1",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
